# SurgeLine — contoh env. Salin ke .env lalu isi. .env TIDAK masuk repo.
# Target app (D3/D9)
SURGELINE_TARGET_PORT=8110
SURGELINE_CHAOS_RATE=0.05          # 5% request gagal (D3)
SURGELINE_CHAOS_SEED=1337          # seed deterministik agar reproducible
# Dashboard (D9/D11)
SURGELINE_DASHBOARD_PORT=8120
# Worker (D7/D8/D12)
SURGELINE_WORKERS=4
SURGELINE_MAX_ATTEMPTS=5
SURGELINE_LEASE_TIMEOUT_SEC=120
SURGELINE_BATCH_SIZE=25
# LLM tidak dipakai di project ini (lihat D12/D15).
